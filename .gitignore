.DS_Store

# build artifacts
/target
**/target

# frontend (Tauri GUI); vite build wipes dist/, so CLI build scripts use artifacts/
node_modules/
dist/
artifacts/

# release binaries (scripts/build-*.sh output; artifacts/ itself is ignored above)
*.zip
*.log
*.exe

# local secrets / runtime state
*.token
*.token.*

# Live deployment configs, tuned in place as operational state (not source;
# untracked 2026-10-08). Final baseline of each stays in git history — compare
# against the last known-good via `git show HEAD:<path>`. READMEs and start
# scripts under deployments/ remain tracked.
deployments/**/interflow.toml

# Certificates and keys never enter git (policy: 2026-09-15; history purged the
# same day — any cert material is issued on demand by the offline issuer and
# lives only on the machine that runs it)
*.key
*.key~
*.crt
*.crt~
*.csr
*.srl
*.pem
# On-demand certificate OUTPUT directories (the suffix rules above already
# cover the material; this catches stray files). crates/certs/ is the
# interflow-certs SOURCE crate, not a generated directory.
certs/
!crates/certs/

# editor (project-shared VS Code settings tracked; the rest stays local —
# a negated pattern needs the parent ignored at file level, not directory level)
.idea/
.vscode/*
!.vscode/settings.json
.zcode/
*.swp

# AI agent working instructions: local-only, each machine keeps its own
# (untracked 2026-10-10; baseline preserved in git history at dc85e69)
CLAUDE.md

# local reference data (unrelated to build)
/data/

# Local reference pages (Rust API Guidelines / Design Patterns scrapes, unrelated to the build)
docs/references/

# Soak guardrail artifacts (nightly local runs; CI uploads them as artifacts, never committed)
bench-results/soak-*/

# CI log bundles dropped into the tree for local analysis (e.g. GitHub run archives)
/logs/
