[Unit]
Description=Interflow agent node desktop
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=30s
ExecStart=/usr/local/bin/interflow agent run --pack /srv/interflow/packs/agent-desktop
Restart=always
RestartSec=5
User=interflow
Group=interflow
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/interflow/packs/agent-desktop

[Install]
WantedBy=multi-user.target
