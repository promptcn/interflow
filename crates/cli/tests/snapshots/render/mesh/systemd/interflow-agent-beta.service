[Unit]
Description=Interflow agent node beta
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=30s
ExecStart=/usr/local/bin/interflow-mesh agent --pack /srv/interflow/packs/agent-beta
Restart=always
RestartSec=5
User=interflow
Group=interflow
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/interflow/packs/agent-beta

[Install]
WantedBy=multi-user.target
