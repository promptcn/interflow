{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interflow",
  "version": "0.1.0",
  "identifier": "com.interflow.expose",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5172",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Interflow",
        "width": 920,
        "height": 660,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:5172 ws://localhost:5172; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
